# ── LLM Configuration ──────────────────────────────────────────────────────────
# Groq (cloud, FREE) — get your key at https://console.groq.com
# When set, Groq is used instead of local Ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (local fallback — only used if GROQ_API_KEY is empty)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT=60

# Embedding Configuration
# Default model: SentenceTransformers all-MiniLM-L6-v2 (384-dimensional)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# File Processing Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Text Splitting & Chunking Config
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# FAISS Vector Database Persistence Config
FAISS_TOP_K=5
FAISS_INDEX_DIR=faiss_data
